# Copy this file to .env and fill in the values.
# .env is ignored by git, so secrets never reach GitHub.

# PostgreSQL connection string.
# Local (see README "Run it locally"): postgresql://teamvory:teamvory@localhost:5432/teamvory
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Online (Neon): DATABASE_URL is the pooled address (host with "-pooler") and DIRECT_URL the
# direct one, used only for database migrations. Leave DIRECT_URL empty on your computer.
DIRECT_URL=""

# --- Email (optional on your computer) ---
# Without RESEND_API_KEY, emails are printed to the terminal instead of sent.
RESEND_API_KEY=""
# Sender address, once a domain is verified in Resend.
EMAIL_FROM="TeamVory <hello@example.com>"
# Where Contact form messages are emailed. On hold until the contact email exists.
CONTACT_INBOX_EMAIL=""

# --- Contact form ---
# Max messages per hour from one IP address (default 5).
CONTACT_MAX_PER_HOUR="5"
# Random text mixed into IP hashes for rate limiting.
IP_HASH_SALT="change-me"

# --- Accounts (Better Auth) ---
# Long random secret that signs session cookies. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The app's address, used in emailed links (invitations, password reset).
BETTER_AUTH_URL="http://localhost:3000"

# --- Daily morning job (availability reminders, email retries) ---
# Vercel Cron sends this as "Authorization: Bearer <secret>". Generate one with:
#   openssl rand -base64 32
# Run the job by hand on your computer:
#   curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/daily
CRON_SECRET=""
