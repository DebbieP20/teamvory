// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Messages sent from the public Contact page. Saved first, then emailed to the
// site owner, so a failed email never loses a message.
model ContactMessage {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  email     String
  message   String
  // SHA-256 of the sender's IP address, only used for rate limiting (never the raw IP).
  ipHash    String?   @map("ip_hash")
  emailedAt DateTime? @map("emailed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([ipHash, createdAt])
  @@map("contact_messages")
}

// ---------------------------------------------------------------------------
// Accounts (Better Auth). Field names follow what Better Auth expects; see
// lib/auth.ts. Passwords live on Account (hashed), never on User.
// ---------------------------------------------------------------------------

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false) @map("email_verified")
  image         String?
  phone         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Businesses and the people in them (docs/database.md)
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  MANAGER
  EMPLOYEE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

/// How the auto-scheduler treats a person (technical plan, section 5).
enum SchedulingMode {
  FAIR_SHARE
  BACKUP
  NOT_SCHEDULED
}

model Business {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  timezone String @default("America/New_York")

  // Optional settings, both off by default (decisions 29 and 30).
  availabilityDeadlineEnabled Boolean @default(false) @map("availability_deadline_enabled")
  /// 1 = Monday ... 7 = Sunday, in the week BEFORE the week being scheduled
  availabilityDeadlineDay     Int     @default(4) @map("availability_deadline_day")
  /// Local wall-clock time, "HH:mm"
  availabilityDeadlineTime    String  @default("18:00") @map("availability_deadline_time")
  timeOffApprovalRequired     Boolean @default(false) @map("time_off_approval_required")

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  memberships Membership[]
  invitations Invitation[]

  @@map("businesses")
}

/// A person's role and status in one business. Never deleted, only set to INACTIVE,
/// so past schedules and hour reports stay correct.
model Membership {
  id                    String                 @id @default(uuid()) @db.Uuid
  userId                String                 @map("user_id")
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId            String                 @map("business_id") @db.Uuid
  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role                  Role
  status                MembershipStatus       @default(ACTIVE)
  schedulingMode        SchedulingMode         @default(FAIR_SHARE) @map("scheduling_mode")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  invitationsSent       Invitation[]
  availabilityTemplate  AvailabilityTemplate[]
  availabilityOverrides AvailabilityOverride[]
  timeOff               TimeOff[]

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("memberships")
}

/// An emailed invitation to join a business. Only a SHA-256 hash of the link's
/// token is stored, so a database leak can't be used to accept invitations.
model Invitation {
  id          String     @id @default(uuid()) @db.Uuid
  businessId  String     @map("business_id") @db.Uuid
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email       String
  role        Role
  tokenHash   String     @unique @map("token_hash")
  invitedById String     @map("invited_by_id") @db.Uuid
  invitedBy   Membership @relation(fields: [invitedById], references: [id])
  expiresAt   DateTime   @map("expires_at")
  acceptedAt  DateTime?  @map("accepted_at")
  revokedAt   DateTime?  @map("revoked_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([businessId])
  @@map("invitations")
}

/// One row per attempt at a rate-limited action (login, sign-up, password reset...).
/// Keys never contain raw emails or IP addresses, only hashes.
model RateLimitEvent {
  id        BigInt   @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("rate_limit_events")
}

// ---------------------------------------------------------------------------
// Availability (technical plan, section 3). Times are local wall-clock
// "HH:mm" strings in the business's time zone; dates are calendar dates.
// ---------------------------------------------------------------------------

enum AvailabilityKind {
  OFF
  ALL_DAY
  CUSTOM
}

/// Someone's usual week: one row per weekday (1 = Monday ... 7 = Sunday).
model AvailabilityTemplate {
  id           String           @id @default(uuid()) @db.Uuid
  membershipId String           @map("membership_id") @db.Uuid
  membership   Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  dayOfWeek    Int              @map("day_of_week")
  kind         AvailabilityKind
  startTime    String?          @map("start_time")
  endTime      String?          @map("end_time")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@unique([membershipId, dayOfWeek])
  @@map("availability_templates")
}

/// A change for one specific date ("this week only"). Replaces the default for that day.
model AvailabilityOverride {
  id           String           @id @default(uuid()) @db.Uuid
  membershipId String           @map("membership_id") @db.Uuid
  membership   Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  date         DateTime         @db.Date
  kind         AvailabilityKind
  startTime    String?          @map("start_time")
  endTime      String?          @map("end_time")
  /// The membership that made the change (the person, or a manager on their behalf)
  enteredById  String           @map("entered_by_id") @db.Uuid
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@unique([membershipId, date])
  @@map("availability_overrides")
}

enum TimeOffStatus {
  PENDING
  APPROVED
  DECLINED
}

/// Whole days someone can't work. APPROVED straight away unless the business
/// requires approval (decision 30).
model TimeOff {
  id           String        @id @default(uuid()) @db.Uuid
  membershipId String        @map("membership_id") @db.Uuid
  membership   Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  startDate    DateTime      @map("start_date") @db.Date
  endDate      DateTime      @map("end_date") @db.Date
  note         String?
  status       TimeOffStatus @default(APPROVED)
  enteredById  String        @map("entered_by_id") @db.Uuid
  reviewedById String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?     @map("reviewed_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([membershipId, startDate])
  @@map("time_off")
}
